{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "portugues-puro",
  "scopeName": "source.escopo.pop",
  "patterns": [
    {
      "include": "#comentários"
    },
    {
      "include": "#strings-literais"
    },
    {
      "include": "#números-literais"
    },
    {
      "include": "#ponteiros-literais"
    },
    {
      "include": "açúcar-sintático"
    },
    {
      "include": "iniciadoras"
    },
    {
      "include": "terminadoras"
    },
    {
      "include": "ambas"
    },
    {
      "include": "sinais-de-pontuação"
    }
  ],
  "repository": {
    "comentários": {
      "patterns": [
        {
          "match": "(\\[.*?\\])",
          "name": "comment.bloco.pop"
        },
        {
          "match": "\\\\(.*)",
          "name": "comment.linha-única.pop"
        },
        {
          "match": "(\\(.*?\\))",
          "name": "comment.block.qualificador.pop"
        }
      ]
    },
    "strings-literais": {
      "patterns": [
        {
          "name": "string.entre.aspas.pop",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "#números-literais": {
      "patterns": [
        {
          "name": "constant.numeric.número.decimal.pop",
          "match": "\\b(-?[\\d]+)\\b"
        },
        {
          "name": "constant.numeric.número.hexadecimal.pop",
          "match": "(\\$[a-fA-F\\d]+)"
        },
        {
          "name": "constant.numeric.número.fracionário.decimal.pop",
          "match": "\\b(-?[\\d]+\\-[\\d]+/[\\d]+)\\b"
        }
      ]
    },
    "#ponteiros-literais": {
      "patterns": [
        {
          "name": "constant.language.ponteiro.pop",
          "match": "\\b(?i:(sim|não|nulo|inexistente|em branco))\\b"
        }
      ]
    },
    "açúcar-sintático": {
      "patterns": [
        {
          "name": "storage.type.function.rotina.pop",
          "match": "\\bRotina\\s+para\\s+que\\s+se\\b"
        },
        {
          "name": "storage.type.function.função.pop",
          "match": "\\bFunção\\s+para\\s+que\\s+se\\b"
        },
        {
          "name": "storage.type.function.outro.pop",
          "match": "\\bpara\\s+que\\s+se\\b"
        },
        {
          "name": "storage.type.function.decisor.pop",
          "match": "\\bdetermine\\s+se\\b"
        }
      ]
    },
    "iniciadoras": {
      "patterns": [
        {
          "name": "keyword.language.iniciador.pop",
          "match": "\\b(?:a|as|essa|essas|esse|esses|esta|estas|este|estes|o|os|um|uma|umas|uns)\\b"
        }
      ]
    },
    "terminadoras": {
      "patterns": [
        {
          "name": "keyword.other.terminador.pop",
          "match": "\\b(?:abaixo|acerca|acima|ainda|algum|ante|antes|aproximadamente|após|através|até|bastante|bem|cabe|cerca|com|começa|começando|começar|como|comprida|comprido|contendo|conter|contiver|contém|contêm|couber|dada|dadas|dado|dados|dando|debaixo|dentre|dentro|depois|desde|deve|devem|deveras|deveria|deveriam|dividido|durante|e|enquanto|entre|então|estamos|estar|estarem|estará|estarão|estava|estavam|estiver|estiverem|está|estão|excede|excedem|existe|existem|existir|finaliza|finalizar|foi|for|foram|forem|houver|há|igual|inicia|iniciar|invoque|juntamente|junto com|já|limitando-o|mais|menores|menos|multiplicado|necessita|necessitar|negativamente|negativo|nem|não|obtendo|ou|parece|parecida|parecido|partindo|partir|perante|perto|pior|pode|podem|podemos|poderia|por|possuem|possui|possuir|pouco|puder|puderem|qual|quanto|quão|regressivamente|relativa|requer|resultando|retornando|seguida de|seguido de|seja|sejam|sem|semelhante|ser|será|serão|similar|sob|sobre|somente|supera|superam|superar|são|só|tal|tanto|tem|ter|termina|terminar|tiver|tão|têm|ultrapassou|usando|versus|vezes|via|voltada|voltado|é)\\b|,|;|\\(referência\\)"
        }
      ]
    },
    "ambas": {
      "patterns": [
        {
          "name": "keyword.control.ambos.pop",
          "match": "\\b(?:ao|aos|chamada|chamadas|chamado|chamados|denominada|denominadas|denominado|denominados|dessa|dessas|desse|desses|desta|destas|deste|destes|dum|duma|dumas|duns|na|nas|nessa|nessas|nesse|nesses|nesta|nestas|neste|nestes|no|nos|num|numa|numas|nuns|pela|pelas|pelo|pelos)\\b"
        }
      ]
    },
    "sinais-de-pontuação": {
      "patterns": [
        {
          "name": "keyword.punctuation.terminator.pop",
          "match": "\\;|\\.|\\,|\\:"
        }
      ]
    },
    "tipos": {
      "patterns": [
        
      ]
    }
  }
}